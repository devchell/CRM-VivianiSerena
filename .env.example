# =============================================================================
# Viviani Serena Platform
# Remote-first environment template for Vercel + Render.
# Set real values in each provider. Do not commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Database and cache
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_HOST:5432/viviani_db?schema=public"
REDIS_URL="rediss://default:PASSWORD@REDIS_HOST:6379"

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=https://api.example.com
CRM_URL=https://crm.example.com
CORS_ORIGIN=https://example.com,https://crm.example.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Auth and crypto
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-me\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NEXTAUTH_SECRET=replace-with-strong-secret
ENCRYPTION_KEY=replace-with-32-char-key
ANONYMIZATION_SALT=replace-with-anonymization-salt

# -----------------------------------------------------------------------------
# Public app URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_LANDING_URL=https://example.com
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Landing publish / revalidation
# Backend and landing route must share this secret.
# -----------------------------------------------------------------------------
LANDING_REVALIDATE_URL=https://example.com/api/revalidate
REVALIDATE_SECRET=replace-with-revalidate-secret

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="Viviani Serena"
ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Google Calendar
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# -----------------------------------------------------------------------------
# Optional SMS / OTP
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Uploads and local storage
# Replace local disk with object storage in production.
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# Logs and operations
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_TO_FILES=false
LOG_DIR=./logs
BACKUP_ENABLED=false
SSL_CERT_EXPIRY_DAYS=90

# -----------------------------------------------------------------------------
# Administrative utilities
# Use only for controlled recovery flows.
# -----------------------------------------------------------------------------
ADMIN_RESET_EMAIL=admin@example.com
ADMIN_RESET_PASSWORD=replace-with-temporary-admin-password
