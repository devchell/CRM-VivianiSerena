# ─── Database (PostgreSQL privado no Docker) ─────────────────────────────────
# Em producao, o Compose injeta a URL interna do servico postgres.
DATABASE_URL=

# ─── Redis privado no Docker ──────────────────────────────────────────────────
REDIS_URL=redis://:change-me@redis:6379

# ─── Storage local persistente ────────────────────────────────────────────────
# ─── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=https://api.example.com
INTERNAL_API_SECRET=
CRM_URL=https://crm.example.com
CORS_ORIGIN=https://www.example.com,https://crm.example.com

# ─── Auth (NextAuth / CRM) ────────────────────────────────────────────────────
NEXTAUTH_URL=https://crm.example.com
NEXTAUTH_SECRET=
NEXT_PUBLIC_API_URL=https://api.example.com

# ─── JWT (RSA key pair) ───────────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=
ANONYMIZATION_SALT=
SEED_ADMIN_PASSWORD=
SEED_COLLABORATOR_PASSWORD=

# ─── Optional integrations ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DISPATCH_ENABLED=false

# TyviaTalk — preencher somente após receber o contrato/API da TyviaTalk
TYVIATALK_API_BASE_URL=
TYVIATALK_API_TOKEN=
TYVIATALK_ACCOUNT_ID=
TYVIATALK_WEBHOOK_SECRET=

# SMTP transacional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Viviani Serena
ADMIN_EMAIL=

# Google Calendar + Google Business OAuth
GOOGLE_CALENDAR_ID=primary

LANDING_REVALIDATE_URL=
REVALIDATE_SECRET=
