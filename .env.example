# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Pooler URL (transaction mode) — use for runtime connections
# Format: postgresql://postgres.[project-id]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://ecivvutwromwlloydech.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ─── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=https://your-api.onrender.com
CRM_URL=https://your-crm.vercel.app
CORS_ORIGIN=https://your-crm.vercel.app,https://your-landing.vercel.app
STORAGE_DRIVER=supabase

# ─── Auth (NextAuth / CRM) ────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-crm.vercel.app
NEXTAUTH_SECRET=
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# ─── JWT (RSA key pair) ───────────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=
ANONYMIZATION_SALT=

# ─── Optional integrations ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

LANDING_REVALIDATE_URL=
