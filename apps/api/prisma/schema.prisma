generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum LeadSource {
  organic
  instagram
  facebook
  google_ads
  referral
  whatsapp
  other
}

enum ServiceType {
  coaching_individual
  coaching_group
  workshop
  mentoring
  consultation
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum TransactionType {
  income
  expense
}

enum FinancialCategory {
  coaching_revenue
  workshop_revenue
  mentoring_revenue
  marketing
  tools_software
  education
  office
  taxes
  other
}

enum ContentSection {
  hero
  about
  services
  testimonials
  faq
  contact
  footer
  seo
}

enum SecurityEventSeverity {
  low
  medium
  high
  critical
}

enum ClientFolderStage {
  before
  progress
  after
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  username              String?   @unique
  name                  String?
  phone                 String?
  passwordHash          String    @map("password_hash")
  totpSecret            String?   @map("totp_secret")
  twoFactorEnabled      Boolean   @default(false) @map("two_factor_enabled")
  twoFactorEmailEnabled Boolean   @default(false) @map("two_factor_email_enabled")
  twoFactorSmsEnabled   Boolean   @default(false) @map("two_factor_sms_enabled")
  role                  UserRole  @default(VIEWER)
  photoUrl              String?   @map("photo_url")
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  allowedModules        String[]  @default([]) @map("allowed_modules")
  createdAt             DateTime  @default(now()) @map("created_at")
  lastLogin             DateTime? @map("last_login")
  failedAttempts        Int       @default(0) @map("failed_attempts")
  lockedUntil           DateTime? @map("locked_until")

  auditLogs            AuditLog[]
  contents             Content[]
  contentVersions      ContentVersion[]
  emailSettingsUpdates EmailSettings[]    @relation("EmailSettingsUpdatedBy")
  notificationReads    NotificationRead[]
  clientFolders        ClientFolder[]     @relation("ClientFolderCreatedBy")
  clients              Client[]           @relation("ClientCreatedBy")

  @@map("users")
}

model EmailSettings {
  id                String   @id @default("default")
  host              String
  port              Int
  secure            Boolean  @default(false)
  user              String   @map("smtp_user")
  passwordEncrypted String   @map("password_encrypted")
  fromEmail         String   @map("from_email")
  fromName          String   @map("from_name")
  adminEmail        String   @map("admin_email")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedBy         String   @map("updated_by")

  updatedByUser User @relation("EmailSettingsUpdatedBy", fields: [updatedBy], references: [id])

  @@map("email_settings")
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  source      LeadSource
  utmSource   String?    @map("utm_source")
  utmMedium   String?    @map("utm_medium")
  utmCampaign String?    @map("utm_campaign")
  status      LeadStatus @default(new)
  notes       String?    @db.Text
  consentedAt DateTime?  @map("consented_at") // LGPD consent timestamp
  anonymized  Boolean    @default(false) // True after GDPR erasure request
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  convertedAt DateTime?  @map("converted_at")

  sessions      Session[]
  appointments  Appointment[]
  clientFolders ClientFolder[]
  clients       Client[]

  @@index([email])
  @@index([status])
  @@index([deletedAt], map: "leads_deleted_at_idx")
  @@index([createdAt])
  @@map("leads")
}

model Session {
  id           String   @id @default(cuid())
  leadId       String?  @map("lead_id")
  ip           String?
  userAgent    String?  @map("user_agent")
  referrer     String?
  pagesVisited Json     @default("[]") @map("pages_visited")
  duration     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  analyticsEvents AnalyticsEvent[]
  webVitals       WebVital[]

  @@index([leadId])
  @@map("sessions")
}

model Appointment {
  id              String            @id @default(cuid())
  leadId          String            @map("lead_id")
  googleEventId   String?           @map("google_event_id")
  date            DateTime
  durationMinutes Int               @default(60) @map("duration_minutes")
  serviceType     ServiceType       @map("service_type")
  status          AppointmentStatus @default(scheduled)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([date])
  @@index([status])
  @@map("appointments")
}

model Financial {
  id          String            @id @default(cuid())
  type        TransactionType
  category    FinancialCategory
  amount      Decimal           @db.Decimal(10, 2)
  description String
  date        DateTime
  recurring   Boolean           @default(false)
  tags        String[]          @default([])
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  @@index([type])
  @@index([category])
  @@index([date])
  @@index([deletedAt], map: "financials_deleted_at_idx")
  @@map("financials")
}

model Client {
  id        String    @id @default(cuid())
  leadId    String?   @map("lead_id")
  name      String
  email     String?
  phone     String?
  notes     String?   @db.Text
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  lead    Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  creator User            @relation("ClientCreatedBy", fields: [createdBy], references: [id])
  folders ClientFolder[]

  @@index([leadId])
  @@index([name])
  @@map("clients")
}

model ClientFolder {
  id                String    @id @default(cuid())
  clientId          String    @map("client_id")
  name              String    @default("Pasta inicial")
  occurredAt        DateTime  @default(now()) @map("occurred_at")
  position          Int       @default(0)
  leadId            String?   @map("lead_id")
  clientName        String    @map("client_name")
  clientEmail       String?   @map("client_email")
  clientPhone       String?   @map("client_phone")
  serviceLabel      String?   @map("service_label")
  notes             String?   @db.Text
  publicTitle       String?   @map("public_title")
  publicDescription String?   @map("public_description") @db.Text
  isPublished       Boolean   @default(false) @map("is_published")
  publicConsentAt   DateTime? @map("public_consent_at")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead    Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client  Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator User                @relation("ClientFolderCreatedBy", fields: [createdBy], references: [id])
  media   ClientFolderMedia[]

  @@index([leadId])
  @@index([clientId, position])
  @@index([isPublished, updatedAt])
  @@index([clientName])
  @@map("client_folders")
}

model ClientFolderMedia {
  id                  String            @id @default(cuid())
  folderId            String            @map("folder_id")
  stage               ClientFolderStage
  capturedAt          DateTime          @map("captured_at")
  note                String?           @db.Text
  originalFilename    String            @map("original_filename")
  originalStorageKey  String            @map("original_storage_key")
  optimizedStorageKey String            @map("optimized_storage_key")
  width               Int
  height              Int
  createdAt           DateTime          @default(now()) @map("created_at")

  folder ClientFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId, capturedAt])
  @@map("client_folder_media")
}

model Content {
  id        String         @id @default(cuid())
  section   ContentSection
  key       String
  value     Json
  updatedAt DateTime       @updatedAt @map("updated_at")
  updatedBy String         @map("updated_by")

  user     User             @relation(fields: [updatedBy], references: [id])
  versions ContentVersion[]

  @@unique([section, key])
  @@map("contents")
}

model ContentVersion {
  id             String         @id @default(cuid())
  contentId      String?        @map("content_id")
  section        ContentSection
  key            String
  value          Json
  version        Int
  reason         String         @default("update")
  restoredFromId String?        @map("restored_from_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  createdBy      String         @map("created_by")

  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [createdBy], references: [id])

  @@unique([section, key, version])
  @@index([section, key, createdAt])
  @@map("content_versions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  resource  String
  details   Json     @default("{}")
  ip        String?
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([resource])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String                @id @default(cuid())
  type      String
  severity  SecurityEventSeverity
  sourceIp  String?               @map("source_ip")
  details   Json                  @default("{}")
  resolved  Boolean               @default(false)
  timestamp DateTime              @default(now())

  @@index([type])
  @@index([severity])
  @@index([timestamp])
  @@index([resolved])
  @@map("security_events")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String?  @map("session_id")
  name      String
  category  String
  label     String?
  value     Float?
  page      String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([name])
  @@index([category])
  @@map("analytics_events")
}

model WebVital {
  id             String   @id @default(cuid())
  sessionId      String?  @map("session_id")
  metricId       String?  @map("metric_id")
  name           String
  value          Float
  rating         String?
  page           String?
  navigationType String?  @map("navigation_type")
  createdAt      DateTime @default(now()) @map("created_at")

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([name])
  @@map("web_vitals")
}

model NotificationRead {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  notificationId String   @map("notification_id")
  readAt         DateTime @default(now()) @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

model AutoTemplate {
  id           String   @id @default(cuid())
  templateId   String   @unique
  emailHtml    String?  @db.Text
  whatsappText String?  @db.Text
  updatedAt    DateTime @updatedAt

  @@map("auto_templates")
}

model LeadStatusTemplate {
  id        String   @id @default(cuid())
  status    String
  channel   String
  subject   String?
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([status, channel])
  @@map("lead_status_templates")
}

// LGPD — Registro de consentimento de uso de dados
model ConsentLog {
  id            String   @id @default(cuid())
  email         String
  ipAddress     String?  @map("ip_address") // Apenas 3 octetos (LGPD)
  policyVersion String   @map("policy_version")
  consentText   String   @map("consent_text") @db.Text
  consentedAt   DateTime @default(now()) @map("consented_at")
  channel       String   @default("landing_form") // landing_form | crm | api

  @@index([email])
  @@index([consentedAt])
  @@map("consent_logs")
}
