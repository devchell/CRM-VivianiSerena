# ============================================================
# Viviani Serena API — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Banco de dados
DATABASE_URL=postgresql://viviani:senha@postgres:5432/viviani?schema=public

# Redis local (Docker)
REDIS_URL=redis://:change-me@redis:6379

# API
DEPLOYMENT_STAGE=development
PORT=4000
NODE_ENV=development
API_BASE_URL=https://api.example.com
INTERNAL_API_SECRET=gere-um-segredo-interno-compartilhado-com-a-landing
CRM_URL=https://crm.example.com
API_HOST=0.0.0.0

# CORS — origens permitidas separadas por vírgula
CORS_ORIGIN=https://www.example.com,https://crm.example.com
COOKIE_SECURE=false
ENABLE_HSTS=false
TRUST_PROXY=true

# JWT — gere com: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Segurança
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-64
ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
ANONYMIZATION_SALT=gere-com-openssl-rand-base64-16
SEED_ADMIN_PASSWORD=defina-uma-senha-forte-com-12-ou-mais-caracteres
SEED_COLLABORATOR_PASSWORD=defina-uma-senha-forte-com-12-ou-mais-caracteres
# ALLOW_BASELINE_RESET=false
# BASELINE_RESET_PASSWORD=defina-uma-senha-temporaria-forte

# Rate Limiting (opcional — padrões: 900000ms, 100 req)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# Landing page revalidação (opcional)
# LANDING_REVALIDATE_URL=https://vivianicoaching.com/api/revalidate
# REVALIDATE_SECRET=gere-um-segredo-aleatorio

# WhatsApp Business API (opcional)
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_GRAPH_API_VERSION=v22.0
# WHATSAPP_DISPATCH_ENABLED=false

# TyviaTalk — contrato/API ainda pendente; não habilitar sem endpoint e assinatura documentados
# TYVIATALK_API_BASE_URL=
# TYVIATALK_API_TOKEN=
# TYVIATALK_ACCOUNT_ID=
# TYVIATALK_WEBHOOK_SECRET=

# Google Calendar + Google Business OAuth (opcional)
# Os nomes abaixo são os consumidos pela API.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
# GOOGLE_CALENDAR_ID=primary

# E-mail transacional via SMTP (opcional; também pode ser salvo pelo painel admin)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=contato@example.com
# EMAIL_FROM_NAME=Viviani Serena
# ADMIN_EMAIL=admin@example.com

# Upload de arquivos (armazenamento local persistente no volume Docker)
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads

# Logs
LOG_DIR=./logs
