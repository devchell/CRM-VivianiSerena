# NextAuth
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-64
NEXTAUTH_URL=https://crm.example.com
NEXT_PUBLIC_LANDING_URL=https://www.example.com

# GOOGLE OAUTH LOGIN — desabilitado (sistema interno)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Google Calendar é configurado na API; o painel admin inicia o OAuth.

# API Backend
NEXT_PUBLIC_API_URL=https://api.example.com
API_BASE_URL=https://api.example.com
