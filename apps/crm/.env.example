# ============================================================
# Viviani Serena CRM — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# NextAuth
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-64
NEXTAUTH_URL=http://localhost:3001

# GOOGLE OAUTH LOGIN — desabilitado (sistema interno)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Google Calendar (OAuth separado — manter para integração de agenda)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.vivianiserena.com.br/api/auth/callback/google-calendar

# API Backend
NEXT_PUBLIC_API_URL=http://localhost:4000
API_BASE_URL=https://api.vivianiserena.com.br
