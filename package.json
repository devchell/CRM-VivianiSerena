{
  "name": "viviani-serena-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:release": "corepack pnpm --filter @viviani/types build && corepack pnpm --filter @viviani/api build && corepack pnpm --filter @viviani/crm build && corepack pnpm --filter @viviani/landing build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "start:api": "corepack pnpm --filter @viviani/api start",
    "start:crm": "corepack pnpm --filter @viviani/crm start",
    "start:landing": "corepack pnpm --filter @viviani/landing start",
    "deploy:check": "corepack pnpm build:release",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "@playwright/test": "1.62.1",
    "baseline-browser-mapping": "2.11.21",
    "caniuse-lite": "1.0.30001810",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "0.6.14",
    "turbo": "^2.9.14",
    "typescript": "^5.4.3"
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=20.20.1 <21",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "2.11.21",
      "brace-expansion@^1.1.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "body-parser": "2.3.0",
      "caniuse-lite": "1.0.30001810",
      "engine.io": "6.6.7",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.5",
      "flatted": "3.4.2",
      "form-data": "4.0.6",
      "glob@^10.2.0": "10.5.0",
      "js-yaml": "4.3.2",
      "linkify-it": "5.0.2",
      "lodash": "4.18.0",
      "markdown-it": "14.2.0",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.0",
      "picomatch@^2.3.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "postcss": "8.5.23",
      "postcss-selector-parser": "6.1.3",
      "fflate": "0.8.3",
      "qs": "6.16.0",
      "socket.io-parser": "4.2.7",
      "uuid": "11.1.1",
      "vite": "6.4.3",
      "yaml": "2.8.3",
      "ws": "8.21.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
