{
  "name": "viviani-serena-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:release": "corepack pnpm --filter @viviani/types build && corepack pnpm --filter @viviani/api build && corepack pnpm --filter @viviani/crm build && corepack pnpm --filter @viviani/landing build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "start:api": "corepack pnpm --filter @viviani/api start",
    "start:crm": "corepack pnpm --filter @viviani/crm start",
    "start:landing": "corepack pnpm --filter @viviani/landing start",
    "deploy:check": "corepack pnpm build:release",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^1.13.3",
    "typescript": "^5.4.3"
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=20.20.1 <21",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
