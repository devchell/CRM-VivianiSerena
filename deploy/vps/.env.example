PUBLIC_HOST=api.example.com
DEPLOYMENT_STAGE=homologacao
PUBLIC_LANDING_URL=https://www.example.com
PUBLIC_CRM_URL=https://crm.example.com
PUBLIC_API_URL=https://api.example.com
INTERNAL_API_SECRET=replace-with-openssl-rand-hex-32
COOKIE_SECURE=false
ENABLE_HSTS=false
TRUST_PROXY=true
API_BIND_ADDRESS=127.0.0.1
CRM_BIND_ADDRESS=127.0.0.1
TLS_CERT_DIR=/opt/viviani-crm/deploy/vps/tls
NGINX_LANDING_HOST=www.example.com
NGINX_CRM_HOST=crm.example.com
NGINX_API_HOST=api.example.com
# Em production, use: docker-compose.yml:deploy/docker/docker-compose.production.yml
# COMPOSE_FILE=docker-compose.yml:deploy/docker/docker-compose.production.yml

POSTGRES_DB=viviani
POSTGRES_USER=viviani
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_APP_USER=viviani_app
POSTGRES_APP_PASSWORD=replace-with-openssl-rand-hex-24
REDIS_PASSWORD=replace-with-openssl-rand-hex-24

JWT_PRIVATE_KEY_B64=replace-with-base64-private-rsa-key
JWT_PUBLIC_KEY_B64=replace-with-base64-public-rsa-key
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
ANONYMIZATION_SALT=replace-with-openssl-rand-hex-16

SEED_ON_START=true
BACKUP_ENABLED=true
# Em production, deve ser um volume/disco externo já montado e gravável.
BACKUP_EXTERNAL_DIR=/mnt/viviani-backups
BACKUP_EXTERNAL_CONFIRMED=false
BACKUP_EXTERNAL_ENCRYPTED_CONFIRMED=false
BACKUP_SCHEDULE_CONFIRMED=false
FIREWALL_PRODUCTION_CONFIRMED=false
SSH_ROOT_ROTATED=false
PRODUCTION_SECRETS_ROTATED=false
FRESH_DATABASE=false
ALLOW_FRESH_BOOTSTRAP=false
REVALIDATE_SECRET=replace-with-openssl-rand-hex-32
LANDING_REVALIDATE_URL=http://landing:3000/api/revalidate
WHATSAPP_DISPATCH_ENABLED=false

# TyviaTalk — preencher após receber domínio, e-mail e contrato/API do provider
TYVIATALK_API_BASE_URL=
TYVIATALK_API_TOKEN=
TYVIATALK_ACCOUNT_ID=
TYVIATALK_WEBHOOK_SECRET=

# Google OAuth (Calendar; requires the final HTTPS domain in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary

# E-mail transacional; alternatively configure these values in the admin panel
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=contato@example.com
EMAIL_FROM_NAME=Viviani Serena
ADMIN_EMAIL=admin@example.com

SEED_ADMIN_PASSWORD=replace-with-a-unique-password-12-chars-minimum
SEED_COLLABORATOR_PASSWORD=replace-with-a-unique-password-12-chars-minimum
